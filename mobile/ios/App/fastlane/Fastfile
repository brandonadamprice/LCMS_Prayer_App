# iOS release lanes, built to run headlessly on the Hallowed Gains build
# server (SSH or the self-hosted GitHub Actions runner) — no Xcode GUI.
# Machine/account-level config is the ~/.ios-build.env contract described in
# docs/ios-build-server.md; per-app values are this directory's Appfile and
# the constants below. New apps copy mobile/ios/App/fastlane/ wholesale and
# change only the Appfile and these constants.

# Fill unset vars from the machine-level env file; anything already in the
# environment (e.g. injected by CI) wins over the file.
require "dotenv"
machine_env = File.expand_path("~/.ios-build.env")
Dotenv.load(machine_env) if File.exist?(machine_env)

default_platform(:ios)

APP_ID = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
APP_NAME = "A Simple Way to Pray"
XCODEPROJ = "App.xcodeproj"
SCHEME = "App"
PROFILE_NAME = "match AppStore #{APP_ID}"

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_KEY_PATH")
    )
  end

  # SSH sessions see the login keychain locked and macOS can't pop its
  # unlock dialog ("SecKeychainItemImport: User interaction is not
  # allowed"), so cert import/codesign silently fail; match itself never
  # unlocks — it only uses MATCH_KEYCHAIN_PASSWORD for the partition list.
  # CI runs skip this: setup_ci builds a throwaway keychain instead.
  private_lane :prepare_keychain do
    next if ENV["CI"]
    password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
    if password.empty?
      UI.user_error!("Set MATCH_KEYCHAIN_PASSWORD in ~/.ios-build.env (the macOS login password of the build user) — needed to unlock the login keychain in SSH sessions. See docs/ios-build-server.md.")
    end
    unlock_keychain(
      path: File.expand_path("~/Library/Keychains/login.keychain-db"),
      password: password
    )
  end

  desc "One-time per app: register the bundle ID (push enabled) with the " \
       "Developer Portal, then generate signing certs/profiles. The App " \
       "Store Connect app entry can't be created here: Apple has no API " \
       "for it (and produce/create_app_online only speaks interactive " \
       "Apple ID login) — it's a one-time browser step, see " \
       "docs/capacitor-ios.md step 3."
  lane :bootstrap do
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    bundle_id = Spaceship::ConnectAPI::BundleId.find(APP_ID)
    if bundle_id
      UI.message("Bundle ID #{APP_ID} is already registered")
    else
      bundle_id = Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, identifier: APP_ID, platform: "IOS")
      UI.success("Registered bundle ID #{APP_ID}")
    end
    begin
      bundle_id.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS)
      UI.success("Enabled the push notifications capability on #{APP_ID}")
    rescue StandardError => e
      UI.important("Push capability not added (#{e.message}) — fine if it was already enabled")
    end
    sync_certs
  end

  desc "Create or renew signing certs + profiles in the shared certs repo"
  lane :sync_certs do
    prepare_keychain
    match(type: "appstore", api_key: asc_api_key, readonly: false)
  end

  desc "Upload the App Store listing (metadata + screenshots, no binary) " \
       "from fastlane/metadata and fastlane/screenshots. Screenshot " \
       "regeneration: mobile/store-assets/capture_ios_screenshots.py."
  lane :sync_store_listing do
    deliver(
      api_key: asc_api_key,
      app_version: get_version_number(xcodeproj: XCODEPROJ, target: "App"),
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true, # no interactive HTML-preview confirmation (headless)
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"] # temp keychain, so runner jobs never touch login keychain
    prepare_keychain
    api_key = asc_api_key
    match(type: "appstore", api_key: api_key, readonly: true)
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1
    update_code_signing_settings(
      path: XCODEPROJ,
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: APP_ID
    )
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      output_directory: "build",
      # CFBundleVersion comes from TestFlight's latest + 1 rather than the
      # repo, so re-runs never collide with an already-uploaded build.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_ID => PROFILE_NAME }
      }
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
